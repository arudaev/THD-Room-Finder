# Copy to android/keystore.properties (gitignored) and fill in to build a
# signed release APK. Keep your release.keystore at the repo root (also
# gitignored) — app/build.gradle reads it at ../../release.keystore.
#
#   cp android/keystore.properties.example android/keystore.properties
#   # edit the values, then:
#   npm run build && npx cap sync android
#   cd android && ./gradlew assembleRelease
#   # APK: android/app/build/outputs/apk/release/app-release.apk
#
# storeFile is fixed to ../../release.keystore in app/build.gradle.
storePassword=CHANGEME
keyAlias=CHANGEME
keyPassword=CHANGEME
