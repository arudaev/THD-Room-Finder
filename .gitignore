# ── Node / Vite ─────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/

# ── Env & secrets ───────────────────────────────────
.env
.env.*.local
.vercel/.env*.local
.vercel/output/
google-services.json
# Signing material — never commit. Keep local; CI recreates from secrets.
keystore.properties
*.keystore
*.jks

# ── Capacitor / Android ─────────────────────────────
# Generated native project is committed, but its build output is not.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
android/app/debug/
android/capacitor-cordova-android-plugins/
*.apk
*.aab
*.ap_
*.dex
*.class

# ── Editors / OS ────────────────────────────────────
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini

# ── Python dev tools ────────────────────────────────
*.pyc
__pycache__/

# ── Logs ────────────────────────────────────────────
crash-logs/
npm-debug.log*
*.log
